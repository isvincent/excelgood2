{
  "id": "TAKE",
  "name": "TAKE",
  "zh": "取出前後幾筆",
  "en": "Take rows or columns",
  "category": "array",
  "level": "進階",
  "version": "Microsoft 365 / Excel 2024",
  "summary": "從表格的開頭或結尾，取出指定數量的列或欄。",
  "summary_en": "Return a set number of rows or columns from the start or end of an array.",
  "syntax": "=TAKE(array, rows, [columns])",
  "slides": [
    {
      "type": "title",
      "title": "TAKE",
      "subtitle": "前幾筆、後幾筆，一次拿",
      "say": [
        "哈囉！今天要學 TAKE 函數。",
        "想取出表格的前三名，",
        "或是最後兩筆最新的紀錄嗎？",
        "交給 TAKE 就對了！"
      ]
    },
    {
      "type": "concept",
      "title": "TAKE 能做什麼？",
      "points": [
        { "icon": "cut", "text": "從表格切出一部分", "at": 1 },
        { "icon": "arrow", "text": "正數從開頭取", "at": 2 },
        { "icon": "swap", "text": "負數從結尾取", "at": 3 },
        { "icon": "grid", "text": "列和欄都能指定", "at": 4 }
      ],
      "say": [
        "TAKE 的重點有四個。",
        "它能從一張表格，切出其中一部分。",
        "填正數，就從開頭往下取。",
        "填負數，就從結尾往回取。",
        "而且列和欄可以同時指定。"
      ]
    },
    {
      "type": "syntax",
      "title": "語法結構",
      "func": "TAKE",
      "args": [
        { "name": "array", "desc": "來源表格", "at": 1 },
        { "name": "rows", "desc": "取幾列", "at": 2 },
        { "name": "columns", "desc": "取幾欄", "optional": true, "at": 3 }
      ],
      "say": [
        "來看語法，共有三個引數。",
        "第一個是來源表格。",
        "第二個是要取幾列，負數從後面取。",
        "第三個是要取幾欄，可以省略。"
      ]
    },
    {
      "type": "sheet",
      "title": "範例一：取前三筆",
      "header": ["姓名", "國文", "數學"],
      "rows": [
        ["王小明", "88", "92"],
        ["林美華", "95", "85"],
        ["陳大文", "76", "90"],
        ["張雅婷", "82", "78"],
        ["李志豪", "90", "88"]
      ],
      "formula": "=TAKE(A2:C6,3)",
      "spill": [
        ["王小明", "88", "92"],
        ["林美華", "95", "85"],
        ["陳大文", "76", "90"]
      ],
      "marks": [
        { "at": 1, "range": "A2:C6", "kind": "range", "label": "來源表格" },
        { "at": 3, "range": "A2:C4", "kind": "hit", "label": "前三列" }
      ],
      "showResultAt": 4,
      "say": [
        "這是一張五位同學的成績表。",
        "來源表格是 A2 到 C6。",
        "第二個引數填三，代表取三列。",
        "正數就從最上面開始取，",
        "前三位同學的資料就出來了！"
      ]
    },
    {
      "type": "sheet",
      "title": "範例二：取最後兩筆、前兩欄",
      "header": ["姓名", "國文", "數學"],
      "rows": [
        ["王小明", "88", "92"],
        ["林美華", "95", "85"],
        ["陳大文", "76", "90"],
        ["張雅婷", "82", "78"],
        ["李志豪", "90", "88"]
      ],
      "formula": "=TAKE(A2:C6,-2,2)",
      "spill": [
        ["張雅婷", "82"],
        ["李志豪", "90"]
      ],
      "marks": [
        { "at": 1, "range": "A5:C6", "kind": "range", "label": "最後兩列" },
        { "at": 2, "range": "A2:B6", "kind": "key", "label": "前兩欄" },
        { "at": 3, "range": "A5:B6", "kind": "hit", "label": "交集" }
      ],
      "showResultAt": 4,
      "say": [
        "這次想要最後兩位的國文成績。",
        "列數填負二，從最後面往回取兩列。",
        "欄數填二，只要前兩欄。",
        "兩個條件交集的地方，",
        "就是張雅婷和李志豪的國文成績！"
      ]
    },
    {
      "type": "build",
      "title": "組合技：國文前三名",
      "parts": [
        { "text": "=TAKE(", "note": "取出前幾列", "at": 1 },
        { "text": "SORT(A2:C6,2,-1)", "note": "依國文由高到低", "at": 2 },
        { "text": ",3)", "note": "只取三列", "at": 3 }
      ],
      "result": "林美華、李志豪、王小明",
      "say": [
        "TAKE 搭配 SORT 威力更強。",
        "外層用 TAKE 取出前幾列。",
        "裡面先用 SORT 依國文由高排到低，",
        "再取三列，就是國文前三名！"
      ]
    },
    {
      "type": "tips",
      "title": "使用小提醒",
      "items": [
        { "kind": "tip", "text": "負數代表從結尾取", "at": 1 },
        { "kind": "tip", "text": "填 0 會出現 #CALC!", "at": 2 },
        { "kind": "tip", "text": "數量超過會整張傳回", "at": 3 },
        { "kind": "tip", "text": "想去掉幾筆請用 DROP", "at": 4 }
      ],
      "say": [
        "來看幾個小提醒。",
        "負數代表從結尾往回取。",
        "列數或欄數填零，會出現錯誤。",
        "數量超過表格大小，就整張傳回。",
        "如果是想去掉幾筆，請改用 DROP。"
      ]
    },
    {
      "type": "quiz",
      "title": "隨堂小測驗",
      "question": "想取出表格最後三列，第二個引數要填什麼？",
      "options": ["3", "-3", "0", "-1"],
      "answer": 1,
      "explain": "負數代表從結尾往回取，所以填 -3。",
      "say": [
        "來個隨堂小測驗！",
        "想取出表格的最後三列，",
        "第二個引數要填什麼呢？",
        "答案是負三！負數從結尾取。"
      ]
    },
    {
      "type": "recap",
      "title": "重點回顧",
      "items": ["從頭或尾取出資料", "正數從頭、負數從尾", "列和欄可同時指定", "搭配 SORT 取前幾名"],
      "say": [
        "重點回顧一下。",
        "TAKE 從表格頭尾取出指定數量。",
        "正數從頭取，負數從尾取。",
        "搭配 SORT，前幾名一秒找出來！"
      ]
    }
  ]
}
