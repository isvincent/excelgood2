    {
      "type": "syntax",
      "title": "語法結構",
      "func": "CHOOSEROWS",
      "args": [
        { "name": "array", "desc": "來源表格", "at": 1 },
        { "name": "row_num1", "desc": "第一個列號", "at": 2 },
        { "name": "row_num2", "desc": "更多列號", "optional": true, "at": 3 }
