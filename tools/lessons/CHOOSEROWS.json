      "say": [
        "來看語法。",
        "第一個引數是來源表格。",
        "第二個是要挑的第一個列號。",
        "後面可以一直加列號，想挑幾列都行。"
      ]
    },
    {
      "type": "sheet",
      "title": "範例一：挑第一和第三列",
      "header": ["姓名", "部門", "分機"],
      "rows": [
        ["王小明", "業務部", "201"],
        ["林美華", "總務部", "305"],
        ["陳大文", "資訊部", "412"],
        ["張雅婷", "人事部", "118"],
        ["李志豪", "業務部", "202"]
      ],
      "formula": "=CHOOSEROWS(A2:C6,1,3)",
      "spill": [
        ["王小明", "業務部", "201"],
        ["陳大文", "資訊部", "412"]
      ],
      "marks": [
        { "at": 1, "range": "A2:C6", "kind": "range", "label": "來源表格" },
