      "rows": [
        ["王小明", "業務部", "201"],
        ["林美華", "總務部", "305"],
        ["陳大文", "資訊部", "412"],
        ["張雅婷", "人事部", "118"],
        ["李志豪", "業務部", "202"]
      ],
      "formula": "=CHOOSEROWS(A2:C6,-1,-2)",
      "spill": [
        ["李志豪", "業務部", "202"],
        ["張雅婷", "人事部", "118"]
      ],
      "marks": [
        { "at": 1, "range": "A6:C6", "kind": "hit", "label": "負一" },
        { "at": 2, "range": "A5:C5", "kind": "key", "label": "負二" }
      ],
      "showResultAt": 3,
      "say": [
        "這次想拿最後兩位新進同仁。",
        "列號負一，代表最後一列，李志豪。",
        "負二，是倒數第二列，張雅婷。",
        "結果依照你寫的順序排列，",
        "所以李志豪在上，張雅婷在下。"
      ]
