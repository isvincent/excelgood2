        ["張雅婷", "2023/2/10", "2025/10/24"]
      ],
      "formula": "=DATEDIF(B2,C2,\"M\")",
      "result": "127",
      "marks": [
        { "at": 1, "range": "B2", "kind": "range", "label": "開始日期" },
